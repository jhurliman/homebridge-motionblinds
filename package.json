{
  "displayName": "MOTION Blinds",
  "name": "homebridge-motionblinds",
  "version": "3.0.0",
  "description": "Homebridge plugin to control MOTION Blinds by Coulisse B.V. including derivative products such as OmniaBlinds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhurliman/homebridge-motionblinds.git"
  },
  "bugs": {
    "url": "https://github.com/jhurliman/homebridge-motionblinds/issues"
  },
  "engines": {
    "node": "^22 || ^24 || ^26",
    "homebridge": "^2.4.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "dependencies": {
    "motionblinds": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "homebridge": "^2.4.0",
    "typescript": "^7.0.2"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "RELEASING.md"
  ]
}
