{
  "name": "homebridge-motionblinds",
  "version": "0.1.0",
  "description": "Homebridge plugin for MotionBlinds (template migration)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint 'src/**/*.ts' || true",
    "prepare": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "motionblinds"
  ],
  "engines": {
    "node": ">=20",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "eslint": "^8.0.0"
  },
  "dependencies": {
    "homebridge": "^2.0.0"
  }
}
