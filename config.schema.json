{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Homebridge MotionBlinds",
  "type": "object",
  "properties": {
    "platform": { "type": "string", "const": "MotionBlindsPlatform" },
    "name": { "type": "string" },
    "host": { "type": "string", "description": "Gateway host (if applicable)" },
    "apiKey": { "type": "string", "description": "API key for MotionBlinds gateway" },
    "useBLE": { "type": "boolean", "description": "Enable BLE discovery" },
    "debug": { "type": "boolean", "description": "Enable debug logging" }
  }
}
